{
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "auto",
  "auth": {
    "rolesSource": "/api/auth-roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "preferred_username",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/edb20124-7377-4368-acbc-d4be58fe59c3/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        },
        "login": {
          "loginParameters": [
            "prompt=select_account"
          ]
        }
      },
      "customOpenIdConnectProviders": {
        "entra": {
          "registration": {
            "clientIdSettingName": "AZURE_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "AZURE_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://login.microsoftonline.com/edb20124-7377-4368-acbc-d4be58fe59c3/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "preferred_username",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "loginParameterNames": [
              "prompt",
              "login_hint"
            ],
            "loginParameters": [
              "prompt=login"
            ]
          }
        }
      }
    }
  },
  "routes": [
    {
      "route": "/admin*",
      "allowedRoles": [
        "admin"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/sync",
      "allowedRoles": [
        "admin"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/roles",
      "allowedRoles": [
        "admin"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/account*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/me/session",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/me/*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/management*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/domain/*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/logout",
      "methods": [
        "POST"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/hub*",
      "redirect": "/management/",
      "statusCode": 301
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/api/*",
      "/admin*",
      "/account*",
      "/management*",
      "/help/*",
      "/*.{css,js,ico,png,svg,jpg,jpeg,webp,json,txt,xml,webmanifest,woff,woff2,html}"
    ]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://login.microsoftonline.com; object-src 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  }
}
