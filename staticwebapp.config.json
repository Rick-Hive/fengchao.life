{
  "platform": { "apiRuntime": "node:20" },
  "trailingSlash": "auto",
  "routes": [
    { "route": "/admin*", "allowedRoles": ["admin"] },
    { "route": "/api/sync", "allowedRoles": ["admin"] },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/logout", "redirect": "/.auth/logout", "statusCode": 302 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/admin*", "/*.{css,js,ico,png,svg,jpg,jpeg,webp}"]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
    }
  }
}
